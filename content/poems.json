  "poems": [
    {"id": "yong-e", "title": "咏鹅", "author": "[唐] 骆宾王", "lesson": "语文园地一", "page": 16,
     "lines": ["鹅，鹅，鹅，", "曲项向天歌。", "白毛浮绿水，", "红掌拨清波。"],
     "polyphones": {"曲": "qū"}, "theme_prop": "白羽毛"},
    {"id": "hua", "title": "画", "author": "", "lesson": "语文园地二", "page": 29,
     "lines": ["远看山有色，", "近听水无声。", "春去花还在，", "人来鸟不惊。"],
     "polyphones": {"还": "hái"}, "theme_prop": "画笔"},
    {"id": "si-shi-si", "title": "绕口令", "author": "传统绕口令", "lesson": 8, "page": 39,
     "lines": ["四是四，", "十是十。", "十四是十四，", "四十是四十。", "四十不是十四，", "十四不是四十。"],
     "polyphones": {}, "theme_prop": "数字牌"},
    {"id": "min-nong", "title": "悯农（其二）", "author": "[唐] 李绅", "lesson": "语文园地四", "page": 58,
     "lines": ["锄禾日当午，", "汗滴禾下土。", "谁知盘中餐，", "粒粒皆辛苦。"],
     "polyphones": {"当": "dāng", "谁": "shuí"}, "theme_prop": "草帽"},
    {"id": "jiang-nan", "title": "江南", "author": "汉乐府", "lesson": "阅读第2课", "page": 62,
     "lines": ["江南可采莲，", "莲叶何田田。", "鱼戏莲叶间。", "鱼戏莲叶东，", "鱼戏莲叶西，", "鱼戏莲叶南，", "鱼戏莲叶北。"],
     "polyphones": {}, "theme_prop": "荷叶"},
    {"id": "gu-lang-yue-xing", "title": "古朗月行（节选）", "author": "[唐] 李白", "lesson": "语文园地六", "page": 82,
     "lines": ["小时不识月，", "呼作白玉盘。", "又疑瑶台镜，", "飞在青云端。"],
     "polyphones": {"作": "zuò"}, "theme_prop": "月亮"}
  ],
